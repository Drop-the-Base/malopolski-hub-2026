# Środowisko Aplikacji (development / production)
APP_ENV=development
PROJECT_NAME="Małopolski Hub Innowacji Społecznych"
DEBUG=true

# Bezpieczeństwo i Klucze Szyfrowania
SECRET_KEY=change-this-in-production-super-secret-key-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Baza Danych Relacyjna (SQLite domyślnie, gotowa na PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./data/mhis.db

# Baza Wektorowa i Pamięć RAG
VECTOR_STORE_DIR=./data/vector_store

# Integracje AI (Opcjonalne - system ma 100% odporny fallback lokalny)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Konfiguracja CORS (Dozwolone pochodzenia)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:80","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Frontend (Vite)
VITE_API_URL=http://localhost:8000/api/v1
